{
  "manifest_version": 3,
  "name": "TabbyPatrol - Cute Tab Guard Cat",
  "version": "1.0.0",
  "description": "A cute AI cat that perches on your tab bar and walks over to swat away blocked tabs!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TabbyPatrol Settings & Pet Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
